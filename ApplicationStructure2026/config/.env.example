# ============================================================
# Portfolio Environment Variables (Template / Placeholders)
# ============================================================
# Copy this file to .env.development or .env.production
# NEVER commit real credentials, passwords, or secrets to Git

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection URI (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Client Application URL (CORS allowed origin, comma-separated for multiple)
CLIENT_URL=https://your-portfolio.vercel.app

# Cryptographic Salt Rounds
SALT_ROUND=12

# JWT Secret Key (64+ random characters for signing admin sessions)
JWT_SECRET=your_jwt_secret_key_here

# Admin Phone Number Credential Hash (bcrypt hash of normalized phone number)
ADMIN_CREDENTIAL_HASH=your_bcrypt_hash_here

# Optional Extra Passphrase Secret Hash (bcrypt hash)
ADMIN_EXTRA_SECRET_HASH=your_extra_secret_hash_here

# Secret Admin Portal URL Path (e.g. /hq-7f3k9x)
ADMIN_PATH=/your_secret_admin_path

# Vercel Blob Storage Read/Write Token
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here
